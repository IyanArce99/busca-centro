      "Bash(/usr/bin/grep -c \"concilio-sevilla\")",
      "Bash(/usr/bin/grep -oE 'fuentes públicas|procede de|Programa de Ayuda' /tmp/cs.html)",
      "Bash(node -e ' *)"
    ]
  }
}
