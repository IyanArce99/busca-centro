{
  "permissions": {
    "allow": [
      "WebFetch(domain:interdiario.es)",
      "Bash(npx tsc *)",
      "Bash(curl -s https://www.buscacentro.es/sitemap.xml)",
      "Bash(curl -s https://www.buscacentro.es/centro/concilio-sevilla)",
      "Bash(/usr/bin/curl -s https://www.buscacentro.es/centro/concilio-sevilla -o /tmp/cs.html)",
      "Bash(/usr/bin/grep -oE '\"robots\":\"[^\"]*\"|name=.robots[^>]*content=.[^\"]*' /tmp/cs.html)",
