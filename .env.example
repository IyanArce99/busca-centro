NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_INDEXABLE=false

# Supabase — get these from your project dashboard → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
# Never expose this in the frontend bundle — server-only
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# /admin — comma-separated emails allowed into the admin panel.
# These users must also exist as real Supabase Auth users (create them in
# Supabase Dashboard → Authentication → Users, or via supabase.auth.admin).
ADMIN_EMAILS=you@example.com
